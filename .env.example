# Cổng nội bộ Node lắng nghe (Nginx sẽ proxy vào đây)
PORT=3000
NODE_ENV=production
# Đường dẫn file SQLite
DB_PATH=./data/xastress.db
# Tên miền chính thức (dùng kiểm tra Origin chống CSRF)
PUBLIC_ORIGIN=https://xastress.info.vn
# Danh sách username quản trị, cách nhau dấu phẩy
ADMIN_USERNAMES=
# Đặt =1 nếu chạy sau reverse proxy (Nginx)
TRUST_PROXY=1
HOST=127.0.0.1
# ---- Cô Tư AI (Claude API) ----
# Khoá API lấy tại https://platform.claude.com – để trống thì quán chạy không có AI
ANTHROPIC_API_KEY=
# Model mặc định: claude-opus-5-5. Muốn tiết kiệm chi phí có thể đổi sang claude-sonnet-5-5 hoặc claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# Mức suy nghĩ: low | medium | high
AI_EFFORT=medium
# ---- Thu phí ----
# Bắt đầu thu phí khi quán có đủ số khách này (mặc định 200). auto | on | off
PAYWALL_USERS=200
PAYWALL_MODE=auto
# ---- Bot Telegram bán xu (thanh toán Telegram Stars) ----
# Tạo bot với @BotFather, dán token vào đây. Để trống thì tắt bán xu.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Hướng dẫn liên hệ khi khách cần hỗ trợ thanh toán (lệnh /paysupport)
TELEGRAM_SUPPORT=Nhắn @ten_admin_cua_ban, ghi rõ mã giao dịch.
# ---- Luật vào quán ----
# Mỗi lượt vào quán phải gọi 1 ly mới được chat/kể chuyện/tặng nước (0 để tắt)
SEAT_GATE=1
# Vắng mặt quá số phút này thì lần online sau tính là lượt vào quán mới (phải gọi ly lại)
VISIT_GAP_MINUTES=30
# ---- Cô Tư hoạt náo (chào khách, khơi chuyện, bình chọn, trả lời khi được gọi) ----
HOST_ENABLED=1
HOST_QUIET_MINUTES=4
HOST_GAP_MINUTES=6
HOST_POLL_MINUTES=5
HOST_POST_DELAY_SEC=120
# ---- Nhà cung cấp AI khác cho Cô Tư (có thể chọn & dán khoá trên trang /admin.html) ----
# Lưu ý: gói ChatGPT Plus / Gemini Advanced KHÔNG có API, cần khoá API riêng.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Khoá mã hoá các khoá API lưu trong CSDL. Để trống thì tự sinh file data/.secret (nhớ sao lưu cùng CSDL)
APP_SECRET=

# ---- Nạp xu chuyển khoản (VietQR + SePay) ----
# Ngân hàng, số tài khoản, khoá webhook SePay và gói xu cài trong trang quản trị → 💳 Thanh toán.
# Webhook SePay: https://<tên miền>/api/pay/webhook/sepay (kiểu chứng thực API Key)
