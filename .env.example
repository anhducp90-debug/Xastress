# Cổng nội bộ Node lắng nghe (Nginx sẽ proxy vào đây)
PORT=3000
NODE_ENV=production
# Đường dẫn file SQLite
DB_PATH=./data/xastress.db
# Tên miền chính thức (dùng kiểm tra Origin chống CSRF)
PUBLIC_ORIGIN=https://xastress.info.vn
# Danh sách username quản trị, cách nhau dấu phẩy
ADMIN_USERNAMES=
# Đặt =1 nếu chạy sau reverse proxy (Nginx)
TRUST_PROXY=1
HOST=127.0.0.1
# ---- Cô Tư AI (Claude API) ----
# Khoá API lấy tại https://platform.claude.com – để trống thì quán chạy không có AI
ANTHROPIC_API_KEY=
# Model mặc định: claude-opus-5-5. Muốn tiết kiệm chi phí có thể đổi sang claude-sonnet-5-5 hoặc claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# Mức suy nghĩ: low | medium | high
AI_EFFORT=medium
